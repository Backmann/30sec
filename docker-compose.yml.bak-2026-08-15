services:
  postgres:
    image: postgres:16-alpine
    container_name: 30sec-postgres
    restart: unless-stopped
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-sec30db}
      POSTGRES_USER: ${POSTGRES_USER:-sec30user}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-ChangeMe_Pg_2026!}
    ports:
      - '127.0.0.1:5432:5432'
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -U ${POSTGRES_USER:-sec30user} -d ${POSTGRES_DB:-sec30db}']
      interval: 10s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-alpine
    container_name: 30sec-redis
    restart: unless-stopped
    command: redis-server --requirepass ${REDIS_PASSWORD:-ChangeMe_Redis_2026!}
    ports:
      - '127.0.0.1:6379:6379'
    volumes:
      - redis_data:/data
    healthcheck:
      test: ['CMD', 'redis-cli', '-a', '${REDIS_PASSWORD:-ChangeMe_Redis_2026!}', 'ping']
      interval: 10s
      timeout: 5s
      retries: 5

  api:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: 30sec-api
    restart: unless-stopped
    env_file:
      - .env
    ports:
      - '127.0.0.1:3000:3000'
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    volumes:
      - uploads_data:/app/uploads
    healthcheck:
      test: ['CMD', 'wget', '--no-verbose', '--tries=1', '--spider', 'http://127.0.0.1:3000/api/health']
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  frontend:
    build:
      context: /root/30sec-frontend
      dockerfile: Dockerfile
    container_name: 30sec-frontend
    restart: unless-stopped
    ports:
      - '127.0.0.1:3001:3001'
    depends_on:
      - api
    healthcheck:
      test: ['CMD', 'wget', '--no-verbose', '--tries=1', '--spider', 'http://127.0.0.1:3001']
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  nginx:
    image: nginx:alpine
    container_name: 30sec-nginx
    restart: unless-stopped
    ports:
      - '80:80'
      - '443:443'
    volumes:
      - ./docker/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
      - ./.htpasswd:/etc/nginx/.htpasswd:ro
      - /etc/letsencrypt:/etc/letsencrypt:ro
      - ./docker/nginx/mycongregation.conf:/etc/nginx/conf.d/mycongregation.conf:ro
      - /etc/cloudflare-origin:/etc/cloudflare-origin:ro
      - /var/www/mycongregation:/var/www/mycongregation:ro
      - /var/www/mycongregation-app:/var/www/mycongregation-app:ro
    depends_on:
      - api
      - frontend


  autoheal:
    image: willfarrell/autoheal:latest
    container_name: 30sec-autoheal
    restart: always
    environment:
      AUTOHEAL_CONTAINER_LABEL: all
      AUTOHEAL_INTERVAL: 30
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock

volumes:
  postgres_data:
  redis_data:
  uploads_data:
