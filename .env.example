# ============================================
# 30sec. — Environment Configuration Example
# ============================================
# Copy this to .env and change ALL passwords/secrets!
# cp .env.example .env

# App
NODE_ENV=production
PORT=3000
APP_URL=http://YOUR_SERVER_IP
API_PREFIX=api

# Database
POSTGRES_DB=sec30db
POSTGRES_USER=sec30user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://sec30user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/sec30db?schema=public

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_PASSWORD@redis:6379

# Auth — JWT (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=CHANGE_ME_32_CHARS_MINIMUM
JWT_REFRESH_SECRET=CHANGE_ME_32_CHARS_MINIMUM
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Admin seed
ADMIN_EMAIL=admin@30sec.game
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NICKNAME=admin
